#!/usr/bin/env bash
# llm-assistant - 启动 AI 助手浮动气泡窗口
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
MAX_WAIT="${LLM_ASSISTANT_MAX_WAIT:-120}"
# 小希默认使用轻量本地助手模型；需要复杂推理时可显式设为 qwen36。
export LLM_ASSISTANT_MODEL_ALIAS="${LLM_ASSISTANT_MODEL_ALIAS:-lfm28}"

# ============================================================
# 依赖检查
# ============================================================
if ! python3 -c "import PyQt6" 2>/dev/null; then
    echo "❌ 需要安装 PyQt6:"
    echo "   sudo pacman -S --needed python-pyqt6"
    exit 1
fi

# Load the window immediately. The model can be started explicitly from the UI.
cd "$SCRIPT_DIR"
exec python3 "$SCRIPT_DIR/llm-assistant-qt.py" "$@"
